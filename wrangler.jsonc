{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tofshield-ada-simulator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "simulator-ada.tofshield.com",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "SimulatorContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "SimulatorContainer",
        "name": "SIMULATOR_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["SimulatorContainer"],
      "tag": "v1"
    }
  ],
  "upload_source_maps": true
}
